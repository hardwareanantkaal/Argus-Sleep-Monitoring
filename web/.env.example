# Web app settings. None of these are secrets; real secrets live only in the backend .env.

# Where the backend listens (dev proxy target for /api/v1 and /socket.io).
BACKEND_URL=http://127.0.0.1:3100

# mock  = every screen uses built-in sample data (no backend needed)
# live  = every screen calls the real backend
# mixed = only the areas listed in NEXT_PUBLIC_LIVE_AREAS call the backend
NEXT_PUBLIC_API_MODE=mock
# Areas: auth, devices, live, claim, sleep, settings, sharing, alerts,
#        admin-devices, customers, ota, team, audit, platform
NEXT_PUBLIC_LIVE_AREAS=auth
