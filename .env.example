# Copy to .env and fill in real values. Never commit .env.
# In dev every value below has a safe default, so .env is optional.

NODE_ENV=development
BACKEND_PORT=3100
LOG_LEVEL=info
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:3101

POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=
DATABASE_URL=

# Generate with: openssl rand -base64 48
JWT_SECRET=
# NEVER change after stickers are printed: every claim code depends on it.
HASH_PEPPER=

MQTT_URL=mqtt://localhost:1885
MQTT_BACKEND_USERNAME=argus-backend
MQTT_BACKEND_PASSWORD=
MQTT_TOPIC_PREFIX=argus
